# Copy to .env.local. `neon env pull` fills the Neon values automatically.
# App connection (Neon pooled string in production/Vercel; local Postgres for offline dev)
DATABASE_URL=postgresql://srbdir@localhost:54329/srbdir
# Direct (unpooled) Neon string - used for migrations, psql and dump restores
DATABASE_URL_UNPOOLED=
NEXT_PUBLIC_SITE_URL=http://localhost:3100
NEXT_PUBLIC_SITE_NAME=Adresar uprave
